#version 450

// CUSA00309 01.07, cs_a16fa93a. This preserves the captured merge algorithm, descriptor
// order, push offsets, equal-key rule and indirect vertex-count write. Every invocation reaches
// every barrier, including the unused lanes of the final partial workgroup.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Count { uint data[]; } count_buf;
layout(set = 0, binding = 1, std430) buffer Indirect { uint data[]; } indirect_buf;
layout(set = 0, binding = 2, std430) readonly buffer Params { uint data[]; } params;
layout(set = 0, binding = 3, std430) coherent buffer A { uint data[]; } a_buf;
layout(set = 0, binding = 4, std430) coherent buffer B { uint data[]; } b_buf;
layout(push_constant, std430) uniform Push { uint words[30]; } pc;

uint offset_words(uint binding) {
    return ((pc.words[20 + binding / 4] >> ((binding % 4) * 8)) & 255u) / 4;
}

uvec2 load_pair(bool from_a, uint index) {
    uint offset = offset_words(from_a ? 3u : 4u) + index * 2;
    if (from_a) {
        return uvec2(a_buf.data[offset], a_buf.data[offset + 1]);
    }
    return uvec2(b_buf.data[offset], b_buf.data[offset + 1]);
}

void store_pair(bool to_a, uint index, uvec2 value) {
    uint offset = offset_words(to_a ? 3u : 4u) + index * 2;
    if (to_a) {
        a_buf.data[offset] = value.x;
        a_buf.data[offset + 1] = value.y;
    } else {
        b_buf.data[offset] = value.x;
        b_buf.data[offset + 1] = value.y;
    }
}

uvec2 merge_pair(bool from_a, uint index, uint count, uint width) {
    uint rank = index & (width - 1);
    uint start = index - rank;
    uint half_width = width / 2;
    uint right = start + half_width;
    if (right >= count) {
        return load_pair(from_a, index);
    }
    uint left_size = min(half_width, count - start);
    uint right_size = min(half_width, count - right);
    uint low = rank > right_size ? rank - right_size : 0;
    uint high = min(rank, left_size);
    while (low < high) {
        uint mid = (low + high) / 2;
        uvec2 left_item = load_pair(from_a, start + mid);
        uvec2 right_item = load_pair(from_a, right + rank - mid - 1);
        if (uintBitsToFloat(left_item.x) > uintBitsToFloat(right_item.x)) {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    uint left_rank = low;
    uint right_rank = rank - low;
    if (left_rank >= left_size) {
        return load_pair(from_a, right + right_rank);
    }
    if (right_rank >= right_size) {
        return load_pair(from_a, start + left_rank);
    }
    uvec2 left_item = load_pair(from_a, start + left_rank);
    uvec2 right_item = load_pair(from_a, right + right_rank);
    return uintBitsToFloat(left_item.x) > uintBitsToFloat(right_item.x) ? left_item
                                                                        : right_item;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint count = count_buf.data[offset_words(0)];
    uint first_width = params.data[offset_words(2)];
    uint last_width = params.data[offset_words(2) + 1];
    if (index == 0 && pc.words[4] > 0) {
        indirect_buf.data[offset_words(1)] = count * 4;
    }

    // These values come from guest buffers and are uniform for the dispatch. Guard malformed
    // widths before entering the synchronized loop; otherwise zero or overflow can hang the GPU.
    if (first_width == 0u || first_width > last_width) {
        return;
    }

    bool from_a = true;
    for (uint width = first_width;; width *= 2) {
        if (index < count) {
            store_pair(!from_a, index, merge_pair(from_a, index, count, width));
        }
        memoryBarrierBuffer();
        barrier();
        if (width >= last_width) {
            break;
        }
        if (width >= 0x80000000u) {
            break;
        }
        from_a = !from_a;
    }
}

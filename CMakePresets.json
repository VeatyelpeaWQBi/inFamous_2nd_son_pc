{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "include": [
    "cmake/CMakeWindowsPresets.json"
  ],
  "configurePresets": [
    {
      "name": "x64-Clang-Release",
      "inherits": [
        "x64-Clang-Base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/Build/Release"
    }
  ]
}
